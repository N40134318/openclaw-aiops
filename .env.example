# =========================
# OpenClaw 基础配置
# =========================

# 所有持久化数据都放在这个目录（包含 workspace）
OPENCLAW_CONFIG_DIR=/home/character/.openclaw

OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan

# 建议你更换一个新的 token（保留也能用）
OPENCLAW_GATEWAY_TOKEN=d28344726a88764a9d3c996f76fe066210c56c9baf0fd5c8c5191ca37008a057

OPENCLAW_IMAGE=openclaw:local

# =========================
# 可选项（保留空即可）
# =========================
OPENCLAW_EXTRA_MOUNTS=
OPENCLAW_HOME_VOLUME=
OPENCLAW_DOCKER_APT_PACKAGES=
OPENCLAW_SANDBOX=
OPENCLAW_DOCKER_SOCKET=/var/run/docker.sock
DOCKER_GID=
OPENCLAW_INSTALL_DOCKER_CLI=
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=

# =========================
# Qwen / DashScope
# =========================
# ⚠️ 填你新生成的 Key（不要再用你刚才贴出来的那个）
DASHSCOPE_API_KEY=
